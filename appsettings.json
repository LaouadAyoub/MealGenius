{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FRONTEND_URL": "http://localhost:3000",
  "CONFIRMATION_PAGE_ROUTE": "/confirm-account",
  "JwtConfig": {
    "Issuer": "MealGenius",
    "Audience": "MealGenius.Frontend"
  },
  "OpenAI": {
    "TextModel": "gpt-4.1-mini",
    "JsonModel": "gpt-4.1-mini",
    "ImageModel": "gpt-image-2",
    "MaxConcurrency": 3,
    "MaxAttempts": 3
  },
  "Generation": {
    "TimeoutMinutes": 20
  },
  "Messaging": {
    "Enabled": true
  },
  "AzureStorageConfig": {
    "ContainerName": "mealgenius-meals-images"
  },
  "Stripe": {
    "Currency": "usd"
  }
}
